{
  "component": {
    "button": {
      "primary": {
        "backgroundColor": {
          "$value": "{semantic.color.fill.emphasis}",
          "$type": "color",
          "$description": "Primary Button fill at rest."
        },
        "textColor": {
          "$value": "{semantic.color.text.inverse}",
          "$type": "color",
          "$description": "Text and icon colour on the primary Button."
        },
        "borderRadius": {
          "$value": "{semantic.radius.sm}",
          "$type": "dimension",
          "$description": "Corner radius of every Button (visual language: Button uses sm)."
        },
        "font": {
          "$value": "{semantic.fontWeight.medium} {semantic.fontSize.md}/{semantic.lineHeight.normal} {semantic.fontFamily.body}",
          "$type": "typography",
          "$description": "Button label typography, the same as sizes.large.font."
        }
      },
      "hover": {
        "$type": "color",
        "backgroundColor": {
          "$value": "color-mix(in srgb, {semantic.color.fill.emphasis}, {semantic.color.text.inverse} calc({semantic.opacity.state.hover} * 100%))",
          "$description": "Primary Button fill on hover."
        }
      },
      "active": {
        "$type": "color",
        "backgroundColor": {
          "$value": "color-mix(in srgb, {semantic.color.fill.emphasis}, {semantic.color.text.inverse} calc({semantic.opacity.state.pressed} * 100%))",
          "$description": "Primary Button fill while pressed."
        }
      },
      "focus": {
        "outline": {
          "$value": "{semantic.border.focus}",
          "$type": "border",
          "$description": "Focus ring on every Button."
