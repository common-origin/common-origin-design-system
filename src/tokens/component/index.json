          },
          "disabled": {
            "backgroundColor": {
              "$value": "{semantic.color.fill.disabled}",
              "$description": "Disabled accent Button fill."
            },
            "textColor": {
              "$value": "{semantic.color.text.disabled}",
              "$description": "Disabled accent Button text and icon colour."
            }
          }
        },
        "danger": {
          "backgroundColor": {
            "$value": "{semantic.color.fill.danger}",
            "$description": "Danger Button fill at rest, for destructive actions."
