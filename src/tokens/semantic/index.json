        },
        "5": {
          "$value": "{base.size.5}",
          "$description": "1.25rem (20px): checkbox box; TabBar count badge; extra-large ProgressBar height (via component tokens); small label height (via size.label.small)."
        },
        "6": {
          "$value": "{base.size.6}",
          "$description": "1.5rem (24px): medium label height (via size.label.medium)."
        },
        "8": {
          "$value": "{base.size.8}",
          "$description": "2rem (32px): checkbox row minimum height (via component tokens); large label height (via size.label.large)."
        },
        "12": {
          "$value": "{base.size.12}",
          "$description": "3rem (48px): AccountCard header minimum height; compact ListItem expanded indent (via component tokens)."
        },
        "15": {
          "$value": "{base.size.15}",
          "$description": "3.75rem (60px): comfortable ListItem expanded indent (via component tokens)."
        },
        "18": {
          "$value": "{base.size.18}",
          "$description": "4.5rem (72px): TransactionListItem minimum height (via component tokens)."
        },
        "20": {
          "$value": "{base.size.20}",
          "$description": "5rem (80px): small EmptyState illustration (via component tokens)."
        },
        "30": {
          "$value": "{base.size.30}",
          "$description": "7.5rem (120px): medium EmptyState illustration; TextArea minimum height (via component tokens)."
        },
        "45": {
          "$value": "{base.size.45}",
          "$description": "11.25rem (180px): Breadcrumbs label truncation width (via component tokens)."
        },
        "50": {
          "$value": "{base.size.50}",
          "$description": "12.5rem (200px): large EmptyState illustration (via component tokens)."
        },
        "75": {
          "$value": "{base.size.75}",
          "$description": "18.75rem (300px): AccountCard minimum width; EmptyState actions maximum width (via component tokens)."
        },
        "90": {
          "$value": "{base.size.90}",
          "$description": "22.5rem (360px): EmptyState text maximum width (via component tokens)."
        },
        "100": {
          "$value": "{base.size.100}",
          "$description": "25rem (400px): EmptyState maximum width (via component tokens)."
        },
        "192": {
          "$value": "{base.size.192}",
          "$description": "48rem (768px): CardLarge maximum width (via component tokens)."
        }
      },
      "icon": {
        "xs": {
          "$value": "{base.size.3}"
        },
        "sm": {
          "$value": "{base.size.4}"
        },
        "md": {
          "$value": "{base.size.5}"
