        },
        "overlay": {
          "$value": "rgba(33, 37, 41, 0.5)",
          "$description": "Semi-transparent scrim for modal, sheet, drawer, and action-sheet backdrops. Uses brand near-black (#212529) at 50% opacity. Sits below the overlay surface and above page content."
        },
        "hover-overlay": {
          "$value": "rgba(33, 37, 41, 0.1)",
          "$description": "Subtle transparent dark overlay for hover states on components that sit over variable-colour backgrounds (e.g. chip close-button hover). Uses brand near-black (#212529) — never pure #000000 per VDL."
        },
        "active-overlay": {
          "$value": "rgba(33, 37, 41, 0.15)",
          "$description": "Slightly stronger transparent dark overlay for active/pressed states on components over variable-colour backgrounds (e.g. chip close-button active). Uses brand near-black (#212529). Pair with hover-overlay for consistent press depth."
        },
        "inverse-overlay": {
          "$value": "rgba(255, 255, 255, 0.2)",
          "$description": "Subtle transparent light overlay for elements that sit on a strong or dark background (e.g. the count badge on an active pills tab in TabBar). The light counterpart of hover-overlay; pair with text.inverse."
        }
