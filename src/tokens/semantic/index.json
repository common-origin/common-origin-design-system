      "dimension": {
        "1": {
          "$value": "{base.size.1}",
          "$description": "0.25rem (4px): TabBar scrollbar height; small ProgressBar height (via component tokens)."
        },
        "2": {
          "$value": "{base.size.2}",
          "$description": "0.5rem (8px): medium ProgressBar height; Badge dot (via component tokens). Approved under decision 0022."
        },
        "4": {
          "$value": "{base.size.4}",
