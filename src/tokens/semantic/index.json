{
  "semantic": {
    "elevation": {
      "$type": "shadow",
      "none": {
        "$value": "{base.shadow.none}",
        "$description": "No elevation - flat surfaces, default state"
      },
      "inset": {
        "$value": "inset 0 2px 4px 0 rgba(0, 0, 0, 0.06)",
        "$description": "Sunken/pressed states, input fields, wells"
      },
      "raised": {
        "$value": "{base.shadow.2}",
        "$description": "Subtle lift - cards, buttons with depth"
      },
      "floating": {
        "$value": "{base.shadow.4}",
        "$description": "Moderate lift - tooltips, popovers, dropdowns"
      },
      "overlay": {
        "$value": "{base.shadow.5}",
        "$description": "High lift - modals, dialogs, action sheets"
      },
      "sticky": {
        "$value": "{base.shadow.3}",
        "$description": "Fixed headers, sticky navigation, bottom bars"
      }
    },
    "breakpoint": {
      "$type": "dimension",
      "xs": {
        "$value": "{base.breakpoint.xs}",
        "$description": "0px: smallest viewport."
      },
      "sm": {
        "$value": "{base.breakpoint.sm}",
        "$description": "640px: large phones."
      },
      "md": {
        "$value": "{base.breakpoint.md}",
        "$description": "768px: tablets; below this, mobile layouts (e.g. fullscreen Modal)."
      },
      "lg": {
        "$value": "{base.breakpoint.lg}",
        "$description": "1024px: small desktops."
      },
      "xl": {
        "$value": "{base.breakpoint.xl}",
        "$description": "1280px: desktops."
      },
      "2xl": {
        "$value": "{base.breakpoint.2xl}",
        "$description": "1536px: wide desktops."
      }
    },
    "opacity": {
      "$type": "number",
      "disabled": {
        "$value": "{base.opacity.50}",
        "$description": "0.5: disabled controls and items."
      },
      "full": {
        "$value": "{base.opacity.100}",
        "$description": "1: fully opaque (the enabled counterpart of disabled)."
      }
    },
    "fontFamily": {
      "$type": "fontFamily",
      "body": {
        "$value": "{base.fontFamily.body}",
        "$description": "UI text (Inter). Use a typography style where one fits; this is for components that set the family on its own."
      },
      "monospace": {
        "$value": "{base.fontFamily.monospace}",
        "$description": "Code and other fixed-width text (CodeBlock)."
      }
    },
    "fontSize": {
      "$type": "dimension",
      "xs": {
        "$value": "{base.fontSize.1}",
        "$description": "0.75rem."
      },
      "sm": {
        "$value": "{base.fontSize.2}",
        "$description": "0.875rem."
      },
      "md": {
        "$value": "{base.fontSize.3}",
        "$description": "1rem."
      },
      "lg": {
        "$value": "{base.fontSize.4}",
        "$description": "1.125rem."
      },
      "xl": {
        "$value": "{base.fontSize.5}",
        "$description": "1.25rem."
      }
    },
    "lineHeight": {
      "none": {
        "$value": "{base.lineHeight.none}",
        "$type": "number",
        "$description": "1 (unitless): line box equals the font size. For single-line glyphs such as avatar initials and count indicators."
      },
      "tight": {
        "$value": "{base.lineHeight.3}",
        "$type": "dimension",
        "$description": "1.25rem: compact multi-line text (Alert, CodeBlock)."
      },
      "normal": {
        "$value": "{base.lineHeight.4}",
        "$type": "dimension",
        "$description": "1.5rem: body-text line height (TextArea)."
      }
    },
    "letterSpacing": {
      "$type": "dimension",
      "tighter": {
        "$value": "{base.letterSpacing.0}",
        "$description": "-0.125rem: tracking for the largest headings (display, h1)."
      },
      "tight": {
        "$value": "{base.letterSpacing.1}",
        "$description": "-0.0625rem: tracking for h2 to h4."
      },
      "normal": {
        "$value": "{base.letterSpacing.2}",
        "$description": "0: default tracking (h5, h6 and text)."
      },
      "wide": {
        "$value": "{base.letterSpacing.4}",
        "$description": "0.125rem: tracking for small uppercase labels (SearchField section headers)."
      }
    },
    "fontWeight": {
      "$type": "fontWeight",
      "regular": {
        "$value": "{base.fontWeight.2}",
        "$description": "400. Body text, captions, most UI text."
      },
      "medium": {
        "$value": "{base.fontWeight.3}",
        "$description": "500. Subheadings (h5, h6, subtitle), buttons, emphasis within UI text."
      },
      "semibold": {
        "$value": "{base.fontWeight.4}",
        "$description": "600. Labels and short titles that need more weight than medium (label, Alert title)."
      },
      "bold": {
        "$value": "{base.fontWeight.5}",
        "$description": "700. Headings (display to h4), overline, strong indicators such as the required-field asterisk."
      }
    },
    "zIndex": {
      "$type": "number",
      "sticky": {
        "$value": "{base.zIndex.1}",
        "$description": "Sticky and fixed chrome that stays visible while scrolling: sticky headers, section headers, navigation bars. Pair with elevation.sticky. Sits below dropdowns, overlays and modals."
      },
      "dropdown": {
        "$value": "{base.zIndex.6}",
        "$description": "Floating menus anchored to a control: dropdown menus, select and autocomplete lists (Dropdown, SearchField). Pair with elevation.floating. Sits above sticky, below overlays."
      },
      "overlay": {
        "$value": "{base.zIndex.7}",
        "$description": "Panels that slide over the page and their backdrop: sheets, drawers (Sheet). The backdrop uses the same value and comes before the panel in the DOM. Pair with elevation.overlay. Sits below modals."
      },
      "modal": {
        "$value": "{base.zIndex.8}",
        "$description": "Blocking dialogs and their backdrop: modals, action sheets (Modal, ActionSheet). The backdrop uses the same value and comes before the dialog in the DOM. Pair with elevation.overlay. Topmost layer in the system."
      }
    },
    "border": {
      "default": {
        "$value": "{base.border.width.1} {base.border.style.solid} {semantic.color.border.default}",
        "$type": "border"
      },
      "subtle": {
        "$value": "{base.border.width.1} {base.border.style.solid} {semantic.color.border.subtle}",
        "$type": "border"
      },
      "strong": {
        "$value": "{base.border.width.1} {base.border.style.solid} {semantic.color.border.strong}",
        "$type": "border"
      },
      "focus": {
        "$value": "{base.border.width.2} {base.border.style.solid} {semantic.color.border.strong}",
        "$type": "border"
      },
      "tooltip": {
        "$value": "{base.border.width.2} {base.border.style.dotted} {semantic.color.border.subtle}",
        "$type": "border"
      },
      "width": {
        "$type": "dimension",
        "thin": {
          "$value": "{base.border.width.1}",
          "$description": "0.0625rem: default hairline borders and rings."
        },
        "thick": {
          "$value": "{base.border.width.2}",
          "$description": "0.125rem: emphasised borders, focus outlines and selected states."
        }
      },
      "focusOffset": {
        "$value": "{base.border.width.2}",
        "$type": "dimension",
        "$description": "0.125rem: magnitude of the gap between an element and its focus outline. Use it as outline-offset directly to draw the outline outside the element, or negated (calc(-1 * …)) to inset it, as TransactionListItem does."
      },
      "radius": {
        "$type": "dimension",
        "none": {
          "$value": "0",
          "$description": "No rounding - tables, dividers, inline code blocks, sharp-edged containers"
        },
        "xs": {
          "$value": "{base.border.radius.1}",
          "$description": "Minimal rounding - small badges, compact tags, inline buttons, checkboxes"
        },
        "sm": {
          "$value": "{base.border.radius.2}",
          "$description": "Subtle rounding - buttons, inputs, chips, form controls, list items"
        },
        "md": {
          "$value": "{base.border.radius.3}",
          "$description": "Standard rounding - cards, containers, dropdowns, popovers, menus"
        },
        "lg": {
          "$value": "{base.border.radius.4}",
          "$description": "Generous rounding - modals, action sheets, dialogs, feature cards, panels"
        },
        "xl": {
          "$value": "{base.border.radius.5}",
          "$description": "Large rounding - pills, pill buttons, prominent CTAs, search bars"
        },
        "2xl": {
          "$value": "{base.border.radius.6}",
          "$description": "Extra large rounding - hero elements, decorative containers, large pills"
        },
        "3xl": {
          "$value": "{base.border.radius.7}",
          "$description": "Maximum rounding - decorative elements, marketing components, large decorative cards"
        },
        "circle": {
          "$value": "{base.border.radius.circle}",
          "$description": "Fully circular - avatars, round icon buttons, status indicators, FABs"
        }
      }
    },
    "size": {
      "$type": "dimension",
      "touchTarget": {
        "$value": "{base.size.11}",
        "$description": "2.75rem (44px): minimum height of a tappable row or control."
      },
      "overlay": {
        "sm": {
          "$value": "{base.size.100}",
          "$description": "25rem (400px): small overlay panel dimension: Modal small width, and the default Sheet width (left and right sheets) and height (top and bottom sheets)."
        },
        "md": {
          "$value": "{base.size.140}",
          "$description": "35rem (560px): medium overlay panel width (Modal medium)."
        },
        "lg": {
          "$value": "{base.size.180}",
          "$description": "45rem (720px): large overlay panel width (Modal large)."
        }
      },
      "label": {
        "small": {
          "$value": "{base.size.5}",
          "$description": "20px label height: StatusLabel small and Tag small. Decision 0018 size scale."
        },
        "medium": {
          "$value": "{base.size.6}",
          "$description": "24px label height: StatusLabel, Tag and CategoryLabel medium. Decision 0018 size scale."
        },
        "large": {
          "$value": "{base.size.8}",
          "$description": "32px label height: CategoryLabel large. Decision 0018 size scale."
        }
      },
      "menu": {
        "maxHeight": {
          "$value": "{base.size.75}",
          "$description": "18.75rem (300px): maximum height of a floating menu before it scrolls (Dropdown, SearchField)."
        }
