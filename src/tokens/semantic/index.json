      }
    },
    "spacing": {
      "$type": "dimension",
      "separator": {
        "sm": {
          "$value": "{base.spacing.4}"
        },
        "md": {
          "$value": "{base.spacing.6}"
        },
        "lg": {
          "$value": "{base.spacing.8}"
        },
        "xl": {
          "$value": "{base.spacing.12}"
        }
      },
      "component": {
        "xs": {
          "$value": "{base.spacing.1}",
          "$description": "Extra-small component internal spacing (0.25rem / 4px). Use for tight gaps within compound elements, icon-to-label spacing in small chips."
        },
        "sm": {
          "$value": "{base.spacing.2}",
          "$description": "Small component internal spacing (0.5rem / 8px). Use for standard icon-to-label gaps, chip padding, compact button inner spacing."
        },
        "md": {
          "$value": "{base.spacing.3}",
          "$description": "Medium component internal spacing (0.75rem / 12px). Use for standard button vertical padding, form field inner padding."
        },
        "lg": {
          "$value": "{base.spacing.4}",
          "$description": "Large component internal spacing (1rem / 16px). Use for button horizontal padding, input horizontal padding, card inner spacing."
        },
        "xl": {
          "$value": "{base.spacing.5}",
          "$description": "Extra-large component internal spacing (1.25rem / 20px). Use for generous button padding, prominent CTAs."
        },
        "2xl": {
          "$value": "{base.spacing.6}",
          "$description": "2x extra-large component internal spacing (1.5rem / 24px). Use for large card inner padding, spacious form sections."
        }
      },
      "layout": {
        "none": {
