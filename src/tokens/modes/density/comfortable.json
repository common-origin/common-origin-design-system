{
  "$description": "Density comfortable (decisions 0032 and 0051): controls and rows one step taller (0034) and their inset one step roomier. Only $value is overridden; each token keeps its description and type from the semantic tier. Interim (issue 396, decision 0060): also overrides three SidebarNav component tokens, its item and switcher text and its icon-to-label gap, until issue 401, issue 402 and issue 403 settle density for text and component tokens system-wide.",
  "semantic": {
    "size": {
      "control": {
        "sm": {
          "$value": "{base.dimension.10}"
        },
        "md": {
          "$value": "{base.dimension.12}"
        },
        "lg": {
          "$value": "{base.dimension.14}"
        }
      },
      "row": {
        "sm": {
          "$value": "{base.dimension.10}"
        },
        "md": {
          "$value": "{base.dimension.14}"
        },
        "lg": {
          "$value": "{base.dimension.20}"
        }
      }
    },
    "space": {
      "inset": {
        "xs": {
          "$value": "{base.dimension.2}"
        },
        "sm": {
          "$value": "{base.dimension.3}"
        },
        "md": {
          "$value": "{base.dimension.4}"
        },
        "lg": {
          "$value": "{base.dimension.5}"
        },
        "xl": {
          "$value": "{base.dimension.6}"
        },
        "2xl": {
          "$value": "{base.dimension.7}"
        }
      }
    }
  },
  "component": {
    "sidebarNav": {
      "item": {
        "typography": {
          "$value": "{semantic.typography.body}"
        },
        "gap": {
          "$value": "{semantic.space.300}"
        }
      },
      "switcher": {
        "typography": {
          "$value": "{semantic.fontWeight.semibold} {semantic.fontSize.md}/{semantic.lineHeight.normal} {semantic.fontFamily.body}"
        }
      }
    }
  }
}
